[Unit]
Description=Tmux Mobile workspace snapshot and app-requested recovery for %i
Documentation=https://github.com/postworthy/tmux-control-center
After=local-fs.target

[Service]
Type=simple
User=%i
EnvironmentFile=/etc/tmux-mobile/workspace-%i.env
ExecStart=/usr/local/libexec/tmux-mobile-workspace-recovery run
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
KillMode=process
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
