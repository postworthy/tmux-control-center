# Install as /etc/tmux-mobile/workspace-USERNAME.env with mode 0640.
HOME=/home/USERNAME
PATH=/home/USERNAME/.local/bin:/home/USERNAME/bin:/usr/local/bin:/usr/bin:/bin
TMUX_WORKSPACE_STATE_DIR=/home/USERNAME/.local/state/tmux-mobile-workspace
TMUX_WORKSPACE_SAVE_INTERVAL_SECONDS=60
TMUX_WORKSPACE_REQUEST_POLL_SECONDS=2
# For a named tmux socket, uncomment and match the app's Tmux__SocketName.
# TMUX_WORKSPACE_SOCKET_NAME=work
