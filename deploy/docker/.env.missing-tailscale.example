TMUX_MOBILE_HOST=tmux-host.example-tailnet.ts.net
TMUX_MOBILE_ORIGIN=https://tmux-host.example-tailnet.ts.net
TMUX_MOBILE_HTTPS_PORT=443
TMUX_MOBILE_IMAGE_TAG=local
TMUX_VERSION=3.4
TMUX_MOBILE_UID=1000
TMUX_MOBILE_GID=1000
TMUX_MOBILE_API_KEY=replace-with-at-least-32-random-bytes
TMUX_SOCKET_DIR=/tmp/tmux-1000
TMUX_SOCKET_NAME=
TMUX_MOBILE_KEYS_DIR=./deploy/docker/state/keys
TMUX_MOBILE_AUDIT_DIR=./deploy/docker/state/audit
TMUX_MOBILE_TLS_CERT=./deploy/docker/secrets/tls.crt
TMUX_MOBILE_TLS_KEY=./deploy/docker/secrets/tls.key
