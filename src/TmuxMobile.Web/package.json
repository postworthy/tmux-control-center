{
  "name": "tmux-mobile-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --config vite.desktop.config.ts",
    "build": "tsc -b && tsc -p tsconfig.desktop.json && vite build && vite build --config vite.desktop.config.ts && node scripts/version-service-worker.mjs",
    "build:desktop": "tsc -p tsconfig.desktop.json && vite build --config vite.desktop.config.ts",
    "test:unit": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/*.test.js",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.desktop.json --pretty false"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  }
}
